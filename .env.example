MC_SDK_PORT=8787
MC_HOST=127.0.0.1
MC_PORT=25565
MC_USERNAME=Luna
MC_VERSION=1.21.1
MC_OWNER=YourMinecraftUsername

# --- Luna mode ---
# simple (default): in-game chat commands + sleep when you sleep
# full: Ollama LLM, voice, autonomous play, learning systems
MC_AI_MODE=simple

# Sleep: when you get in bed, Luna uses/places hers nearby
MC_SYNC_OWNER_SLEEP=true
MC_SLEEP_SEARCH_RADIUS=48
MC_SLEEP_GOODNIGHT=true

MC_SKIN_PATH=assets/skins/luna.png
MC_SKIN_MODEL=slim
MC_USE_MINESKIN=true
MC_RESPAWN_NEAR_OWNER=true
MC_ALLOW_TP=true
MC_CHEST_SEARCH_RADIUS=48
MC_CHEST_REQUIRE_EMPTY=false

# Tree-chop reinforcement: rewards chops/pillars; -1 for empty jumps; learns climb timing
# MC_TREE_RL=false
# MC_TREE_RL_FILE=data/tree_chop_rl.json
# MC_TREE_RL_PLACE_JUMP_MS=120
# MC_TREE_RL_MOUNT_JUMP_MS=220

